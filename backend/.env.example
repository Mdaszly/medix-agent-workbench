# ===== LLM（可选，不填则走本地规则 + RAG 兜底）=====
MEDIX_API_KEY=
MEDIX_BASE_URL=https://www.dmxapi.cn/v1
MEDIX_MODEL_NAME=gpt-5-mini
MEDIX_ENABLE_LLM=false

# ===== Dify 集成 =====
# 在 Dify 应用「访问 API」页面获取
DIFY_API_KEY=app-xxxxxxxx
DIFY_APP_ID=your-app-uuid
DIFY_API_URL=https://api.dify.ai/v1
# 单次请求超时（秒），超时后降级到 LangGraph
DIFY_TIMEOUT=90

# ===== 公网隧道（Dify HTTP 工具节点需要能访问本地后端）=====
# 运行 scripts/start_tunnel.ps1 后，将输出的 URL 填到这里
PUBLIC_TUNNEL_URL=https://your-subdomain.trycloudflare.com
# 后端监听端口，须与 config.yaml 中 server.port 一致
BACKEND_PORT=8012
